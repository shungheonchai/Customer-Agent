# Local disposable PostgreSQL, bound only to loopback by compose.yaml.
DATABASE_URL=postgresql+psycopg://bookly:bookly_local@127.0.0.1:5435/bookly
# Leave empty for scripted fixtures; set a provider to enable live LLM replies.
# Provider: anthropic, openai, or google (Gemini).
LLM_PROVIDER=
# Exact tool-capable model ID from the selected provider; no provider prefix.
LLM_MODEL=
# Key for the selected provider or gateway. Never commit real keys.
LLM_API_KEY=
# Optional compatible gateway/API root. Blank uses the provider's public API.
# LLM_BASE_URL=
# Optional host ports when the defaults are already in use.
BOOKLY_WEB_PORT=8010
BOOKLY_DB_PORT=5435

